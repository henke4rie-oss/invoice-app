# Secret key for JWT signing
SECRET_KEY=dev-secret-change-in-production

# Database URL
DATABASE_URL=sqlite:///./data/app.db

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Where uploaded business logos are stored
# LOGOS_DIR=./data/logos

# Debug mode
DEBUG=true

# Demo mode: "Try the live demo" button + shared pre-filled account, reset every hour on the hour (UTC)
DEMO_ENABLED=true

# Scheduler time (HH:MM format)
SCHEDULER_TIME=09:00

# Access-token lifetime in minutes
ACCESS_TOKEN_MINUTES=120

# Reverse proxies in front of the app (0 = none). Behind Render set 1; the client IP for rate limiting
# is then the 1st entry from the right of X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# Real SMTP delivery is opt-in. Leave false to only log reminders even if SMTP_* is set.
ALLOW_OUTBOUND_EMAIL=false

# Max reminder deliveries per user per UTC day
MAX_REMINDERS_PER_DAY=50

# SMTP settings for email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=true
